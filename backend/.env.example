# Copy to .env and fill in. Never commit the real .env file.

# MySQL connection (used unless DATABASE_URL is set directly)
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=wdsl_webtoolkit

# Or set this directly to override the pieces above:
# DATABASE_URL=mysql+pymysql://user:password@host:3306/wdsl_webtoolkit

JWT_SECRET_KEY=change-me-to-a-long-random-string

# Google Gemini API key for Task 1 (AI Suggestion Generator).
# If left blank, /api/analyze still works but returns a clearly-labeled
# fallback suggestion instead of a real AI-generated one.
GEMINI_API_KEY=

# SMTP credentials for the /api/payment/slip endpoint (forwards an uploaded
# payment slip to PAYMENT_NOTIFY_EMAIL as an attachment; nothing is stored).
# If left blank, the endpoint returns a clear error and the frontend's
# WhatsApp option still works as a fallback.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
PAYMENT_NOTIFY_EMAIL=premodya667@gmail.com
# General/business contact (Contact Us page) -- kept distinct from
# PAYMENT_NOTIFY_EMAIL above.
CONTACT_NOTIFY_EMAIL=info@wdsl.lk
